{
  "components": {
    "responses": {
      "ProblemDetails": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description": "A stable FSP operator API error.",
        "headers": {
          "X-Correlation-ID": {
            "description": "Correlation identifier also returned in the response body.",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      },
      "StaleRevision": {
        "content": {
          "application/problem+json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "code": {
                      "const": "stale_revision"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          }
        },
        "description": "The supplied configuration revision is stale.",
        "headers": {
          "X-Correlation-ID": {
            "description": "Correlation identifier also returned in the response body.",
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "AgentList": {
        "additionalProperties": false,
        "properties": {
          "agents": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "dead": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "agents",
          "dead"
        ],
        "type": "object"
      },
      "ConfigurationSnapshot": {
        "additionalProperties": false,
        "properties": {
          "config_file": {
            "type": "string"
          },
          "settings": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "settings",
          "config_file"
        ],
        "type": "object"
      },
      "ConfigurationUpdate": {
        "additionalProperties": false,
        "properties": {
          "settings": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "required": [
          "settings"
        ],
        "type": "object"
      },
      "ConfigurationUpdateResult": {
        "additionalProperties": true,
        "properties": {
          "changed": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ok": {
            "type": "boolean"
          },
          "restart_required": {
            "type": "boolean"
          }
        },
        "required": [
          "ok",
          "changed",
          "restart_required"
        ],
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": true,
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "correlationId": {
            "minLength": 1,
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlationId"
        ],
        "type": "object"
      },
      "QueueActionResult": {
        "additionalProperties": true,
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "ok"
        ],
        "type": "object"
      },
      "SourceValidationResult": {
        "additionalProperties": true,
        "properties": {
          "capabilities": {
            "additionalProperties": true,
            "type": "object"
          },
          "objects": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array"
          },
          "ok": {
            "const": true
          },
          "server_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "ok",
          "source_id"
        ],
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "agentBearer": {
        "description": "Microsoft Entra access token accepted on Agent control routes.",
        "scheme": "bearer",
        "type": "http"
      },
      "agentToken": {
        "description": "Shared Agent token accepted when token authentication is configured.",
        "in": "header",
        "name": "X-Agent-Token",
        "type": "apiKey"
      },
      "operatorBasic": {
        "description": "Manager operator credentials when standalone authentication is configured.",
        "scheme": "basic",
        "type": "http"
      },
      "operatorBearer": {
        "description": "Microsoft Entra operator access token.",
        "scheme": "bearer",
        "type": "http"
      },
      "sigV4": {
        "description": "AWS Signature Version 4 authorization for the S3 data plane.",
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
