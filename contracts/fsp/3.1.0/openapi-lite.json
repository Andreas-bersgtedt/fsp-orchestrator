    "/_admin/refresh": {
      "post": {
        "description": "Rebuild every table's Iceberg snapshot (e.g., after schema/data change).\n\nWith AUTO_REFRESH enabled, this forces a content-addressed materialize +\npublish per table (bypassing the change probe): a new snapshot version is\npublished only for tables whose content actually changed.\n\nWith ICEBERG_SNAPSHOT_HISTORY enabled, this instead *advances* each table to\na new snapshot version (retaining history for time-travel); the shared data\nfiles are reused, so only the metadata/manifest caches are cleared.",
        "operationId": "refresh_snapshot__admin_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
