@baseUrl = https://localhost:9443

### Get API health
GET {{baseUrl}}/api/health
Accept: application/json

### Get startup readiness
GET {{baseUrl}}/api/ready
Accept: application/json

### Get public Entra configuration
GET {{baseUrl}}/api/auth/config
Accept: application/json

### Get signed-in operator session
GET {{baseUrl}}/api/session
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Get prerequisite catalog
GET {{baseUrl}}/api/prerequisites/catalog
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Start prerequisite run
POST {{baseUrl}}/api/prerequisites/runs
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "operation": "deploy",
  "inputs": {
    "target": "environment-a"
  }
}

### Get prerequisite run
GET {{baseUrl}}/api/prerequisites/runs/{{runId}}
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Cancel prerequisite run
POST {{baseUrl}}/api/prerequisites/runs/{{runId}}/cancel
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Validate prerequisite run for apply
POST {{baseUrl}}/api/prerequisites/runs/{{runId}}/validate
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "operation": "deploy",
  "inputs": {
    "target": "environment-a"
  }
}

### Get database diagnostics
GET {{baseUrl}}/api/system/database
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Create database backup
POST {{baseUrl}}/api/system/database/backups
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Restore database backup
POST {{baseUrl}}/api/system/database/restore
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "fileName": "orchestrator-20261015-100000-example.db",
  "sha256": "replace-with-approved-sha256"
}

### Validate selected Entra application registrations
POST {{baseUrl}}/api/identity/registrations/validate
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "tenantId": "00000000-0000-0000-0000-000000000001",
  "signedInTenantId": "00000000-0000-0000-0000-000000000001",
  "spa": {
    "objectId": "00000000-0000-0000-0000-000000000010",
    "appId": "00000000-0000-0000-0000-000000000011",
    "displayName": "FSP Orchestrator SPA",
    "signInAudience": "AzureADMyOrg",
    "spaRedirectUris": ["https://localhost:9443/auth/callback"],
    "identifierUris": [],
    "delegatedScopes": [],
    "appRoles": [],
    "preAuthorizedApplications": [],
    "passwordCredentialCount": 0,
    "keyCredentialCount": 0
  },
  "api": {
    "objectId": "00000000-0000-0000-0000-000000000020",
    "appId": "00000000-0000-0000-0000-000000000021",
    "displayName": "FSP Orchestrator API",
    "signInAudience": "AzureADMyOrg",
    "spaRedirectUris": [],
    "identifierUris": ["api://00000000-0000-0000-0000-000000000021"],
    "delegatedScopes": [
      {
        "id": "00000000-0000-0000-0000-000000000030",
        "value": "orchestrator.access_as_user",
        "type": "User",
        "isEnabled": true
      }
    ],
    "appRoles": [
      { "id": "00000000-0000-0000-0000-000000000031", "value": "Reader", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000032", "value": "Operator", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000033", "value": "ConfigurationAdmin", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000034", "value": "DeploymentAdmin", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000035", "value": "SecurityAdmin", "allowedMemberTypes": ["User"], "isEnabled": true }
    ],
    "preAuthorizedApplications": [
      {
        "appId": "00000000-0000-0000-0000-000000000011",
        "delegatedPermissionIds": ["00000000-0000-0000-0000-000000000030"]
      }
    ],
    "passwordCredentialCount": 0,
    "keyCredentialCount": 0
  },
  "spaServicePrincipalExists": true,
  "apiServicePrincipalExists": true,
  "signedInUserRoles": ["SecurityAdmin"]
}

### Get the OpenAPI document
GET {{baseUrl}}/openapi/v1.json
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Load the hosted SPA
GET {{baseUrl}}/
Accept: text/html

### Register an existing FSP deployment
POST {{baseUrl}}/api/deployments
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}

### Hand off delegated Azure Resource Manager token
POST {{baseUrl}}/api/azure/session
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "accessToken": "{{AZURE_RESOURCE_MANAGER_ACCESS_TOKEN}}"
}

### List allowed Azure subscriptions
GET {{baseUrl}}/api/azure/subscriptions
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}

### List resources after server-side subscription validation
GET {{baseUrl}}/api/azure/resources?subscriptionId={{subscriptionId}}&resourceGroup={{resourceGroup}}
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "name": "Production FSP",
  "managerEndpoint": "https://fsp.example.com",
  "azureResourceId": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/fsp/providers/Microsoft.ContainerService/managedClusters/fsp",
  "credentialKind": "Bearer",
  "credentialReference": "https://example.vault.azure.net/secrets/fsp-manager-token"
}

### Save a typed Azure deployment profile
PUT {{baseUrl}}/api/deployment-profiles/{{profileId}}
Accept: application/json
Authorization: ******
Content-Type: application/json

{
  "name": "Production FSP",
  "subscriptionId": "{{subscriptionId}}",
  "resourceGroupName": "fsp-rg",
  "deploymentName": "fsp-deployment",
  "location": "swedencentral",
  "kubernetesVersion": "1.32.7",
  "nodeVmSku": "Standard_D4s_v5",
  "nodeCount": 3,
  "requestedRegionalVcpu": 12,
  "aksName": "fsp-aks",
  "vnetName": "fsp-vnet",
  "subnetName": "aks-subnet",
  "vnetCidr": "10.0.0.0/16",
  "aksSubnetCidr": "10.0.0.0/24",
  "podCidr": "10.1.0.0/16",
  "serviceCidr": "10.2.0.0/16",
  "dnsServiceIp": "10.2.0.10",
  "privateDnsZoneName": "privatelink.swedencentral.azmk8s.io"
}

### Run ARM validation and structured what-if
POST {{baseUrl}}/api/deployment-profiles/{{profileId}}/preview
Accept: application/json
Authorization: ******
Content-Type: application/json

{
  "prerequisiteRunId": "{{runId}}"
}

### Approve the exact current preview and its change counts
POST {{baseUrl}}/api/deployment-profiles/{{profileId}}/approval
Accept: application/json
Authorization: ******
Content-Type: application/json

{
  "previewId": "{{previewId}}"
}

### Get a registered deployment
GET {{baseUrl}}/api/deployments/{{deploymentId}}
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}

### List registered deployments and observation state
GET {{baseUrl}}/api/deployments
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}

### Get latest and last successful observations
GET {{baseUrl}}/api/deployments/{{deploymentId}}/observations/current
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}

### Refresh deployment observations
POST {{baseUrl}}/api/deployments/{{deploymentId}}/observations
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}

### List job reports for a deployment
GET {{baseUrl}}/api/deployments/{{deploymentId}}/jobs
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}

### Validate release compatibility before mutation
POST {{baseUrl}}/api/deployments/{{deploymentId}}/mutation-gate
Accept: application/json
Authorization: Bearer {{ORCHESTRATOR_ACCESS_TOKEN}}
