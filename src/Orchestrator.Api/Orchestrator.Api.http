    "keyCredentialCount": 0
  },
  "api": {
    "objectId": "00000000-0000-0000-0000-000000000020",
    "appId": "00000000-0000-0000-0000-000000000021",
    "displayName": "FSP Orchestrator API",
    "signInAudience": "AzureADMyOrg",
    "spaRedirectUris": [],
    "identifierUris": ["api://00000000-0000-0000-0000-000000000021"],
    "delegatedScopes": [
      {
        "id": "00000000-0000-0000-0000-000000000030",
        "value": "orchestrator.access_as_user",
        "type": "User",
        "isEnabled": true
      }
    ],
    "appRoles": [
      { "id": "00000000-0000-0000-0000-000000000031", "value": "Reader", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000032", "value": "Operator", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000033", "value": "ConfigurationAdmin", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000034", "value": "DeploymentAdmin", "allowedMemberTypes": ["User"], "isEnabled": true },
      { "id": "00000000-0000-0000-0000-000000000035", "value": "SecurityAdmin", "allowedMemberTypes": ["User"], "isEnabled": true }
    ],
