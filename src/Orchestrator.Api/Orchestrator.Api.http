@baseUrl = https://localhost:9443

### Get API health
GET {{baseUrl}}/api/health
Accept: application/json

### Get startup readiness
GET {{baseUrl}}/api/ready
Accept: application/json

### Get public Entra configuration
GET {{baseUrl}}/api/auth/config
Accept: application/json

### Get signed-in operator session
GET {{baseUrl}}/api/session
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Get prerequisite catalog
GET {{baseUrl}}/api/prerequisites/catalog
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Start prerequisite run
POST {{baseUrl}}/api/prerequisites/runs
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "operation": "deploy",
  "inputs": {
    "target": "environment-a"
  }
}

### Get prerequisite run
GET {{baseUrl}}/api/prerequisites/runs/{{runId}}
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Cancel prerequisite run
POST {{baseUrl}}/api/prerequisites/runs/{{runId}}/cancel
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Validate prerequisite run for apply
POST {{baseUrl}}/api/prerequisites/runs/{{runId}}/validate
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "operation": "deploy",
  "inputs": {
    "target": "environment-a"
  }
}

### Get database diagnostics
GET {{baseUrl}}/api/system/database
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Create database backup
POST {{baseUrl}}/api/system/database/backups
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}

### Restore database backup
POST {{baseUrl}}/api/system/database/restore
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "fileName": "orchestrator-20261015-100000-example.db",
  "sha256": "replace-with-approved-sha256"
}

### Validate selected Entra application registrations
POST {{baseUrl}}/api/identity/registrations/validate
Accept: application/json
Authorization: Bearer {{$dotenv ORCHESTRATOR_ACCESS_TOKEN}}
Content-Type: application/json

{
  "tenantId": "00000000-0000-0000-0000-000000000001",
  "signedInTenantId": "00000000-0000-0000-0000-000000000001",
  "spa": {
    "objectId": "00000000-0000-0000-0000-000000000010",
    "appId": "00000000-0000-0000-0000-000000000011",
    "displayName": "FSP Orchestrator SPA",
    "signInAudience": "AzureADMyOrg",
    "spaRedirectUris": ["https://localhost:9443/auth/callback"],
    "identifierUris": [],
    "delegatedScopes": [],
    "appRoles": [],
    "preAuthorizedApplications": [],
